# Cloudflare Pages: the page itself and the images that change are always re-checked, so a new deploy reaches everyone.
# Hashed build files (/assets) never change under the same name, so they stay cached for a year.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/art/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/*
  Cache-Control: public, max-age=31536000, immutable
